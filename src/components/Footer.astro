---
import menu from '../../menu.json';

const { business } = menu;
---

<footer class="footer" id="footer">
  <div class="footer-content">
    <div class="footer-brand">
      <span class="brand-name">{business.name}</span>
      <p class="copyright">© 2026 {business.name}. {business.tagline}.</p>
    </div>
    
    <div class="footer-links">
      <a href="#menu">Menu</a>
      <a href="#historia">Nuestra Historia</a>
      <a href="#menu">Carrito</a>
      <a href="#">Términos de Servicio</a>
    </div>
    
    <div class="footer-social">
      <a href="https://github.com/IgnacioAlme/PepoPizza" aria-label="GitHub" class="social-link" target="_blank" rel="noopener noreferrer">
        <img src="/PepoPizza/assets/images/github-142-svgrepo-com.svg" alt="GitHub" class="social-icon" />
      </a>
      <a href="https://www.instagram.com/pepopizzahouse/" aria-label="Instagram" class="social-link" target="_blank" rel="noopener noreferrer">
        <img src="/PepoPizza/assets/images/instagram-svgrepo-com.svg" alt="Instagram" class="social-icon" />
      </a>
    </div>
  </div>
  
  <div class="footer-bottom">
    <p>Hecho con amor en Corrientes Capital</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-on-surface);
    color: var(--color-surface);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 3rem 2rem;
    max-width: 80rem;
    margin: 0 auto;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-name {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-surface);
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--color-outline-variant);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--color-outline-variant);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-social {
    display: flex;
    gap: 1.5rem;
  }

  .social-link {
    color: var(--color-outline-variant);
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-surface);
  }

.social-link .social-icon {
    width: 1.5rem;
    height: 1.5rem;
    filter: grayscale(1) invert(1);
  }

  .social-link:hover .social-icon {
    filter: none;
  }
</style>
